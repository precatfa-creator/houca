# Supabase project settings (Project Settings → API in the Supabase dashboard).
# Both values are public by design: they are compiled into the browser bundle
# and access is enforced by row-level security in supabase/migrations.
# NEVER put the service_role key or database password here.

# Project URL, e.g. https://abcdefghijkl.supabase.co
VITE_SUPABASE_URL=

# Publishable key (sb_publishable_...) or legacy anon key (eyJ...)
VITE_SUPABASE_ANON_KEY=
